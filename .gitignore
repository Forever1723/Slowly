# 依赖（本项目零依赖，正常情况下不会有）
node_modules/
pnpm-lock.yaml

# 运行时数据：每个人自己的记录，绝对不进仓库
data/
*.tmp-*
*.broken-*

# 编辑器与系统文件
.vscode/
.idea/
Thumbs.db
Desktop.ini
*.lnk

# 安卓编译产物
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.apk
*.aab

# 日志与临时文件
*.log
*.bak

# GitHub 要求令牌带 workflow 权限才能推送工作流文件。
# 补上 workflow 权限后，删掉下面两行再发布即可让云端编译 APK。
.github/workflows/build-apk.yml
android/.github/workflows/build-apk.yml
